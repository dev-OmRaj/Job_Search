# Create an API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_cloud_api_key

# Direct Ollama Cloud API. Direct cloud calls use the model name without
# the `-cloud` suffix.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# Local Ollama is used only for EmbeddingGemma.
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Keep local embedding requests small and retry only a failed batch.
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_DELAY_SECONDS=1

DATABASE_URL=sqlite:///data/job_search.db
COMPANY_DATABASE_URL=sqlite:///data/companies.db
